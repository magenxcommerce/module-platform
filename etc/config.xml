 *
 * The module is inert until an admin opens the page — it runs no cron, writes
 * nothing and touches no request path — so it ships on. The status endpoints
 * default to the internal Docker network addresses this stack publishes.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magenx_platform>
            <general>
                <enabled>1</enabled>
                <timeout>3</timeout>
                <cache_ttl>10</cache_ttl>
                <auto_refresh>0</auto_refresh>
            </general>
            <collectors>
                <!--
                    imgproxy is deliberately absent: it is the one backend that is not
                    part of every deployment, and the multiselect is generated from the
                    collector pool, so the tab is offered without being switched on.
                -->
                <enabled_collectors>mariadb,redis,rabbitmq,opensearch,php,nginx,frankenphp,security,compatibility,integrations</enabled_collectors>
            </collectors>
            <endpoints>
                <nginx_status_url>http://nginx/nginx_status</nginx_status_url>
                <fpm_status_url>http://nginx/fpm_status</fpm_status_url>
                <rabbitmq_management_url/>
                <!--
                    NOT the port imgproxy serves images on (IMGPROXY_BIND, 4593 on this
                    stack). IMGPROXY_PROMETHEUS_BIND opens a second listener and cannot
                    share the first, so this is deliberately the next port up.
                -->
                <imgproxy_metrics_url>http://imgproxy:4594/metrics</imgproxy_metrics_url>
                <!--
                    A Caddy site block that runs only the metrics handler, not the admin
                    API on 2019: the admin API serves the same registry but also accepts
                    POST /load, and has no read-only mode.
                -->
                <frankenphp_metrics_url>http://frankenphp:2020/metrics</frankenphp_metrics_url>
            </endpoints>
            <!--
                The Security and Compatibility tabs ask four public services:
                magento.watch for the release's open bulletins and system
                requirements, Packagist for advisories against locked packages
                and for their newest versions, and the Mage-OS mirror for the
                composer manifest of the release an upgrade would install. What
                leaves the server is the release string and package names, never
                credentials, over https only. Off, both tabs still report the
                installed release, local patch records and measured versions.
            -->
            <advisories>
                <enabled>1</enabled>
                <release_api_url>https://magento.watch/api/v1</release_api_url>
                <packagist_url>https://packagist.org</packagist_url>
                <packagist_repo_url>https://repo.packagist.org</packagist_repo_url>
                <magento_repo_url>https://mirror.mage-os.org</magento_repo_url>
            </advisories>
        </magenx_platform>
    </default>
</config>
